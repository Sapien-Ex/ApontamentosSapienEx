# PostgreSQL
# Usados pelo container do Postgres para criar o usuário e o banco na primeira subida.
# Mudar depois não altera o banco já criado: só vale com o volume vazio.
POSTGRES_USER=usuario_do_banco
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=nome_do_banco

# API
# Usuário, senha e banco têm que ser os mesmos de cima.
# O prefixo +psycopg define o driver (psycopg 3).
# Host localhost porque a API roda fora do Docker, direto na sua máquina”.
# Quando a API rodar dentro do docker-compose, troque localhost pelo nome do serviço do banco (db).
# Senha com caracteres especiais (@ : / # %) precisa ser codificada na URL.
DATABASE_URL=postgresql+psycopg://usuario_do_banco:troque_esta_senha@localhost:5432/nome_do_banco

# Testes
# Banco separado, criado à mão uma vez. Os testes nunca devem apontar para o banco de dev.
TEST_DATABASE_URL=postgresql+psycopg://usuario_do_banco:troque_esta_senha@localhost:5432/nome_do_banco_test